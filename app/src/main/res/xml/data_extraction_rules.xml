<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the sets and settings move to a new phone with the device backup. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="library.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="library.json" />
    </device-transfer>
</data-extraction-rules>
