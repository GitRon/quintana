root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 140
ktlint_code_style = intellij_idea
# Composables are named like classes.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Long parameter lists stay one per line instead of being joined up to the line limit.
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 5
